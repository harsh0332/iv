# =========================================================================
# IVY ESTATE BHOPAL - PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. Deployment Site URL
# Used for canonical URL references and generating correct sitemaps/robots configurations.
NEXT_PUBLIC_SITE_URL=https://www.ivyestatebhopal.in

# 2. Dynamic Contact Parameters
# Raw values (no spaces or special chars except +) used to configure CTAs, headers, and footer buttons.
NEXT_PUBLIC_PHONE_NUMBER=+919893223331
NEXT_PUBLIC_WHATSAPP_NUMBER=919893223331

# 3. Webhook Integration URL (n8n, CRM, or Google Sheets)
# Submissions from forms (Site Visit, Callback, Inquiries) are sent to this address.
# The server-side route will try to send requests to WEBHOOK_URL first, then fallback to public.
WEBHOOK_URL=https://formspree.io/f/mnjyvzav
NEXT_PUBLIC_WEBHOOK_URL=

# 4. Analytics & Tracking Scripts
# Leave blank to disable loading tracking scripts in production or development.
# Google Analytics ID (Measurement ID, starting with G-):
NEXT_PUBLIC_GA_ID=
GA_ID=

# Meta Pixel ID (15-digit number):
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
